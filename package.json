{
  "name": "setup-custom-tool",
  "description": "Download, unpack, and add to PATH a tool of your choice",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "author": "Alex079",
  "license": "MIT",
  "homepage": "https://github.com/Alex079/setup-custom-tool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex079/setup-custom-tool.git"
  },
  "bugs": {
    "url": "https://github.com/Alex079/setup-custom-tool/issues"
  },
  "keywords": [
    "actions",
    "tool",
    "setup"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "coverage": "npx make-coverage-badge --output-path ./badges/coverage.svg",
    "package": "npx rollup --config rollup.config.js",
    "all": "npm run clean && npm run format:write && npm run lint && npm run test && npm run coverage && npm run package",
    "clean": "npx rimraf dist coverage"
  },
  "devDependencies": {
    "@actions/core": "^3.0.0",
    "@actions/glob": "^0.5.0",
    "@actions/tool-cache": "^4.0.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.0",
    "@jest/globals": "^30.2.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.57.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
